generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  role         String         @default("RECRUITER")
  createdAt    DateTime       @default(now())
  stageChanges StageHistory[]
}

model Job {
  id          String      @id @default(cuid())
  title       String
  department  String
  location    String
  type        String      // Full-time, Part-time, Contract, Internship
  status      String      @default("Open") // Open, Closed
  description String      @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  candidates  Candidate[]
}

model Candidate {
  id              String         @id @default(cuid())
  fullName        String
  email           String         @unique
  phone           String?
  currentRole     String?
  currentCompany  String?
  experienceYears Int            @default(0)
  skills          String[]       @default([])
  source          String         @default("Other") // LinkedIn, Referral, Job Board, Website, Other
  expectedSalary  Int?
  location        String?
  resumeUrl       String?
  notes           String?        @db.Text
  stage           String         @default("Applied") // Applied, Screening, Interview, Technical Round, Offer, Hired, Rejected
  rating          Int            @default(0)
  rejectionReason String?
  jobId           String?
  job             Job?           @relation(fields: [jobId], references: [id])
  stageHistory    StageHistory[]
  interviewNotes  InterviewNote[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([stage])
  @@index([email])
  @@index([jobId])
  @@index([createdAt])
}

model StageHistory {
  id              String    @id @default(cuid())
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fromStage       String
  toStage         String
  changedById     String?
  changedBy       User?     @relation(fields: [changedById], references: [id])
  changedAt       DateTime  @default(now())
  note            String?
  rejectionReason String?

  @@index([candidateId])
}

model InterviewNote {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  scheduledAt DateTime?
  interviewer String?
  note        String?   @db.Text
  createdAt   DateTime  @default(now())
}
